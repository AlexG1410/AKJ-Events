{
  "name": "akj-checkin-emulator-tests",
  "private": true,
  "type": "module",
  "overrides": { "@grpc/grpc-js": "1.14.7" },
  "scripts": {
    "test": "firebase emulators:exec --project demo-akj-checkin --config ../firebase.checkin-test.json --only auth,firestore \"node --test --test-concurrency=1 checkin.test.js deletion.test.js\"",
    "test:android": "firebase emulators:exec --project demo-akj-checkin --config ../firebase.checkin-test.json --only auth,firestore \"powershell -NoProfile -File run-android-tests.ps1\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.3.0",
    "firebase-tools": "15.36.0"
  }
}
